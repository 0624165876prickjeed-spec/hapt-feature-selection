    "main_training_data_augmentation": false
  },
  "methods": [
    {"id": "B0", "selection": "all_valid_features", "lambda": 0, "beta": 0},
    {"id": "B1", "selection": "mi", "lambda": 0, "beta": 0},
    {"id": "B2", "selection": "mi_redundancy", "lambda": 0, "beta": 0.1},
    {"id": "A1", "selection": "mi_stability", "lambda": "training_cv_grid", "beta": 0},
    {"id": "P", "selection": "mi_stability_redundancy", "lambda": "training_cv_grid", "beta": 0.1}
  ],
  "noise": {
    "injection_location": "continuous_raw_record_before_windowing_and_features",
