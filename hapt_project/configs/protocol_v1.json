  },
  "training_statistics": {
    "fit_scope": "current_training_subjects_only_refit_every_fold",
    "constant_threshold": "std_ddof0<=1e-12*max(1,abs(training_mean))",
    "mi": {"estimator": "mutual_info_classif", "discrete_features": false, "n_neighbors": 3, "n_jobs": 1, "fit_on": "clean_training_standardized_features", "normalizer": "divide_by_max_or_all_zero_if_max_nonpositive"},
    "stability": {
