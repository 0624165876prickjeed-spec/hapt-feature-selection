      "raw_penalty": "median_over_windows_and_replicates(abs(noisy_feature-clean_feature))/scale",
      "bounded_penalty": "raw_penalty/(1+raw_penalty)"
    },
    "redundancy": "mean_absolute_clean_training_pearson_with_selected_features_empty_set_zero"
  },
  "selection": {
    "k_grid": [20, 40, 60],
